NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Research executes in Convex. Set these in the Convex dashboard / `convex env set`,
# not just in this Next.js environment. Never use NEXT_PUBLIC_ for the Exa key.
EXA_API_KEY=
RESEARCH_ENABLED=false
# Optional research effort (defaults to medium).
EXA_RESEARCH_EFFORT=medium
